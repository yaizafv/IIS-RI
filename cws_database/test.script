CREATE USER SA PASSWORD DIGEST 'd41d8cd98f00b204e9800998ecf8427e'
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.TINVOICES(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,DATE DATE,ENTITYSTATE VARCHAR(255),NUMBER BIGINT NOT NULL,STATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,SUBTOTAL NUMERIC(19,2),TOTAL NUMERIC(19,2),VATAMOUNT NUMERIC(19,2),VATRATE NUMERIC(38),CONSTRAINT UNQ_TINVOICES_4 UNIQUE(NUMBER))
CREATE MEMORY TABLE PUBLIC.TINTERVENTIONS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,DATE TIMESTAMP,ENTITYSTATE VARCHAR(255),MINUTES INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,MECHANIC_ID VARCHAR(255),WORKORDER_ID VARCHAR(255),CONSTRAINT UNQ_TINTERVENTIONS_0 UNIQUE(MECHANIC_ID,WORKORDER_ID,DATE))
CREATE MEMORY TABLE PUBLIC.TPAYMENTMEANS(ID VARCHAR(255) NOT NULL PRIMARY KEY,DTYPE VARCHAR(31),CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,ACCUMULATED NUMERIC(19,2),CLIENT_ID VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.TSPAREPARTS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CODE VARCHAR(255) NOT NULL,CREATEDAT TIMESTAMP,DESCRIPTION VARCHAR(255),ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,PRICE NUMERIC(19,2),CONSTRAINT UNQ_TSPAREPARTS_1 UNIQUE(CODE))
CREATE MEMORY TABLE PUBLIC.TVOUCHERS(ID VARCHAR(255) NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(255),AVAILABLE NUMERIC(19,2),CODE VARCHAR(255) NOT NULL,CONSTRAINT UNQ_TVOUCHERS_3 UNIQUE(CODE),CONSTRAINT FK_TVOUCHERS_ID FOREIGN KEY(ID) REFERENCES PUBLIC.TPAYMENTMEANS(ID))
CREATE MEMORY TABLE PUBLIC.TCLIENTS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,CITY VARCHAR(255),COUNTRY VARCHAR(255),POSTALCODE VARCHAR(255),STREET VARCHAR(255),EMAIL VARCHAR(255),NAME VARCHAR(255),SURNAME VARCHAR(255),NIF VARCHAR(9) NOT NULL,PHONE VARCHAR(255) NOT NULL,CONSTRAINT UNQ_TCLIENTS_12 UNIQUE(NIF))
CREATE MEMORY TABLE PUBLIC.TSUBSTITUTIONS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),QUANTITY INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,PRICE NUMERIC(19,2),INTERVENTION_ID VARCHAR(255),SPAREPART_ID VARCHAR(255),CONSTRAINT UNQ_TSUBSTITUTIONS_0 UNIQUE(INTERVENTION_ID,SPAREPART_ID),CONSTRAINT FK_TSUBSTITUTIONS_SPAREPART_ID FOREIGN KEY(SPAREPART_ID) REFERENCES PUBLIC.TSPAREPARTS(ID),CONSTRAINT FK_TSUBSTITUTIONS_INTERVENTION_ID FOREIGN KEY(INTERVENTION_ID) REFERENCES PUBLIC.TINTERVENTIONS(ID))
CREATE MEMORY TABLE PUBLIC.TVEHICLETYPES(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),NAME VARCHAR(255) NOT NULL,UPDATEDAT TIMESTAMP,VERSION BIGINT,PRICE_PER_HOUR NUMERIC(19,2),CONSTRAINT UNQ_TVEHICLETYPES_3 UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.TCASHES(ID VARCHAR(255) NOT NULL PRIMARY KEY,CONSTRAINT FK_TCASHES_ID FOREIGN KEY(ID) REFERENCES PUBLIC.TPAYMENTMEANS(ID))
CREATE MEMORY TABLE PUBLIC.TWORKORDERS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,DATE TIMESTAMP,DESCRIPTION VARCHAR(255),ENTITYSTATE VARCHAR(255),STATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,TOTAL_AMOUNT NUMERIC(19,2),INVOICE_ID VARCHAR(255),MECHANIC_ID VARCHAR(255),VEHICLE_ID VARCHAR(255),CONSTRAINT UNQ_TWORKORDERS_0 UNIQUE(VEHICLE_ID,DATE),CONSTRAINT FK_TWORKORDERS_INVOICE_ID FOREIGN KEY(INVOICE_ID) REFERENCES PUBLIC.TINVOICES(ID))
CREATE MEMORY TABLE PUBLIC.TCHARGES(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,CHARGE NUMERIC(19,2),INVOICE_ID VARCHAR(255),PAYMENTMEAN_ID VARCHAR(255),CONSTRAINT UNQ_TCHARGES_0 UNIQUE(INVOICE_ID,PAYMENTMEAN_ID),CONSTRAINT FK_TCHARGES_INVOICE_ID FOREIGN KEY(INVOICE_ID) REFERENCES PUBLIC.TINVOICES(ID),CONSTRAINT FK_TCHARGES_PAYMENTMEAN_ID FOREIGN KEY(PAYMENTMEAN_ID) REFERENCES PUBLIC.TPAYMENTMEANS(ID))
CREATE MEMORY TABLE PUBLIC.TCREDITCARDS(ID VARCHAR(255) NOT NULL PRIMARY KEY,TYPE VARCHAR(255),VALIDTHRU DATE,CARD_NUMBER VARCHAR(255) NOT NULL,CONSTRAINT UNQ_TCREDITCARDS_3 UNIQUE(CARD_NUMBER),CONSTRAINT FK_TCREDITCARDS_ID FOREIGN KEY(ID) REFERENCES PUBLIC.TPAYMENTMEANS(ID))
CREATE MEMORY TABLE PUBLIC.TVEHICLES(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),MAKE VARCHAR(255),MODEL VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,LICENSEPLATE VARCHAR(255) NOT NULL,CLIENT_ID VARCHAR(255),VEHICLETYPE_ID VARCHAR(255),CONSTRAINT UNQ_TVEHICLES_7 UNIQUE(LICENSEPLATE),CONSTRAINT FK_TVEHICLES_VEHICLETYPE_ID FOREIGN KEY(VEHICLETYPE_ID) REFERENCES PUBLIC.TVEHICLETYPES(ID),CONSTRAINT FK_TVEHICLES_CLIENT_ID FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.TCLIENTS(ID))
CREATE MEMORY TABLE PUBLIC.TMECHANICS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,NAME VARCHAR(255),SURNAME VARCHAR(255),NIF VARCHAR(9) NOT NULL,CONSTRAINT UNQ_TMECHANICS_7 UNIQUE(NIF))
ALTER TABLE PUBLIC.TINTERVENTIONS ADD CONSTRAINT FK_TINTERVENTIONS_WORKORDER_ID FOREIGN KEY(WORKORDER_ID) REFERENCES PUBLIC.TWORKORDERS(ID)
ALTER TABLE PUBLIC.TINTERVENTIONS ADD CONSTRAINT FK_TINTERVENTIONS_MECHANIC_ID FOREIGN KEY(MECHANIC_ID) REFERENCES PUBLIC.TMECHANICS(ID)
ALTER TABLE PUBLIC.TPAYMENTMEANS ADD CONSTRAINT FK_TPAYMENTMEANS_CLIENT_ID FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.TCLIENTS(ID)
ALTER TABLE PUBLIC.TWORKORDERS ADD CONSTRAINT FK_TWORKORDERS_MECHANIC_ID FOREIGN KEY(MECHANIC_ID) REFERENCES PUBLIC.TMECHANICS(ID)
ALTER TABLE PUBLIC.TWORKORDERS ADD CONSTRAINT FK_TWORKORDERS_VEHICLE_ID FOREIGN KEY(VEHICLE_ID) REFERENCES PUBLIC.TVEHICLES(ID)
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
